# Handle line endings automatically for files detected as text 
# and force all text files to use LF (Unix-style) line endings.
* text=auto eol=lf

# Explicitly declare standard text files
*.dart text
*.yaml text
*.json text
*.md text
*.txt text
*.xml text
*.gradle text
*.properties text
*.html text
*.css text
*.js text

# Declare files that should always be treated as binary
# (Git won't try to fix line endings in these)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.ttf binary
*.otf binary
*.pdf binary